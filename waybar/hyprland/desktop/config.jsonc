// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 0, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "custom/arrow_tray",
        "tray",
        "custom/arrow_pulseaudio",
        "pulseaudio",
        "custom/arrow_cpu",
        "cpu",
        "custom/arrow_clock",
        "clock",
        "custom/power"

    ],
    "hyprland/workspaces": {
    "format": "{icon}",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'"
    },
    "hyprland/window":{
      "format":"{title:.80}"
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },
    "clock": {
        //"timezone": "Europe/Warsaw",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format":"{:%H:%M   %d-%m-%Y}"
        
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon}", 
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
      "custom/power": {
        "format" : "⏻ ",
        "tooltip": false,
        "on-click": "wlogout"
    },
    "custom/arrow_tray":{
        "format":"\ue0b2",
        "tooltip": false
    },
    "custom/arrow_pulseaudio":{
        "format":"\ue0b2",
        "tooltip": false
    },
    "custom/arrow_cpu":{
        "format":"\ue0b2",
        "tooltip": false
    },
    "custom/arrow_backlight":{
        "format":"\ue0b2",
        "tooltip": false
    },
    "custom/arrow_battery":{
        "format":"\ue0b2",
        "tooltip": false
    },
    "custom/arrow_clock":{
        "format":"\ue0b2",
        "tooltip": false
    }
}
